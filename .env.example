# Copy this file to .env on your EC2 and fill in real values.
# NEVER commit .env to Git.

# Amazon ECR registry URL (from Step 2 of DEPLOYMENT_GUIDE.md)
# Format: <account-id>.dkr.ecr.<region>.amazonaws.com
ECR_REGISTRY=123456789012.dkr.ecr.ap-south-1.amazonaws.com

# Image tag — updated automatically by the CI/CD pipeline
IMAGE_TAG=latest

# PostgreSQL
DB_USER=aegis
DB_PASSWORD=CHANGE_ME_strong_password

# RabbitMQ
RABBIT_USER=aegis
RABBIT_PASSWORD=CHANGE_ME_strong_password

# JWT secret — minimum 32 chars, use a random string
JWT_SECRET=CHANGE_ME_at_least_32_random_chars_here!!

# CORS — your frontend URL (can be the EC2 IP for now)
CORS_ORIGINS=http://YOUR_EC2_PUBLIC_IP:5173
